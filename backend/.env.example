# OnePanel 后端环境变量示例
# 用法：复制为 backend/.env（本地开发）或在项目根目录 .env（docker compose 读取）
# 该文件仅包含示例值，不要把真实密钥提交进仓库

# ====== 必填 ======
# JWT 签名密钥：务必改成随机长字符串，泄露等于面板被完全接管
# 生成方式：openssl rand -hex 32
JWT_SECRET=please-change-me-to-a-random-64-char-hex-string

# 数据库位置（容器内默认 /app/data/dev.db，对应 compose 的 ./data 卷）
DATABASE_URL=file:./dev.db

# 可选：固定数据加密密钥（备忘录 / 备份包）
# 默认不设：密钥由管理员登录密码保护，登录/解锁后才可解密，重启需解锁一次
# 只有希望"无人值守也能自动备份"时才设置它；一旦设置就成唯一钥匙，丢失不可恢复
# 生成方式：openssl rand -hex 32
# APP_SECRET=

# ====== 可选 ======
# 时区，影响告警时间与备份文件名
TZ=Asia/Shanghai

# 服务端口
PORT=3000

# 允许跨域的来源（逗号分隔）。不设置=允许所有来源
# CORS_ORIGIN=https://panel.example.com,http://192.168.1.10:3000

# 登录失败限速（15 分钟内允许的失败次数）
LOGIN_RATE_LIMIT=10

# 请求体上限（主题壁纸走 base64 时可能偏大）
JSON_LIMIT=20mb

# 恢复备份时允许解压后的最大字节数（防压缩炸弹）
MAX_RESTORE_BYTES=134217728

# ====== 在线监测 ======
MONITOR_INTERVAL_MS=60000
MONITOR_OFFLINE_THRESHOLD=5
MONITOR_RETRY=3
MONITOR_RETRY_DELAY_MS=3000

# ====== 多线路探活 ======
PROBE_TIMEOUT_MS=2500

# ====== 企业微信推送请求超时 ======
WECHAT_TIMEOUT_MS=8000
