{
  "manifest_version": 3,
  "name": "OnePanel 快速收藏",
  "version": "1.1.0",
  "description": "右键保存页面到 OnePanel，自动跟随面板主题",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "保存到 OnePanel"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
